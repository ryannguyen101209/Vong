# Copy this file to .env and fill it in:  cp .env.example .env

# Password for the /admin page. If you leave this unset the app falls back to
# "vong-admin" and warns you on every start. Change it before going online.
ADMIN_PASSWORD=change-me-before-you-deploy

# Port the API listens on. The Vite dev server proxies to it.
PORT=4000

# Google OAuth web client ID. Set the same site's exact HTTPS origin in
# Google Cloud > APIs & Services > Credentials > Authorized JavaScript origins.
# The client ID is public; no Google client secret is needed for ID-token login.
GOOGLE_CLIENT_ID=

# Only set behind a known reverse proxy. Render uses one trusted hop.
# TRUST_PROXY_HOPS=1

# Where the SQLite file lives, relative to the server/ folder.
DATABASE_FILE=data/vong.db

# Leave unset in development. In production set it to your site's origin,
# e.g. https://vong.vn, so only your own frontend can call the API.
# CORS_ORIGIN=https://your-domain.com

# Private analytics dashboard. Leave unset to disable /api/analytics.
ANALYTICS_KEY=

# Automatic emails (approved / rejected listings, new chat messages) through
# Resend. Leave RESEND_API_KEY unset to send nothing. MAIL_FROM must be on a
# domain you verified in Resend, e.g. "Vòng <hello@usevong.com>".
RESEND_API_KEY=
MAIL_FROM=
# MAIL_REPLY_TO=
# Daily database backup, emailed through Resend (needs RESEND_API_KEY too).
# Leave unset to turn it off; Admin > Settings can still download a copy.
BACKUP_EMAIL=

# Automatic payment confirmation through SePay (https://sepay.vn). Leave
# SEPAY_API_KEY unset to keep confirming payments by hand. It must match the API
# key you give SePay when you create the webhook (16+ characters).
SEPAY_API_KEY=
# Only count transfers into this account number (optional).
# SEPAY_ACCOUNT_NUMBER=
# true = a verified payment publishes the listing at once, without your approval.
# PAYMENT_AUTO_PUBLISH=false
