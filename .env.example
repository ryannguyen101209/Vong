# Copy this file to .env and fill it in:  cp .env.example .env

# Password for the /admin page. If you leave this unset the app falls back to
# "vong-admin" and warns you on every start. Change it before going online.
ADMIN_PASSWORD=change-me-before-you-deploy

# Port the API listens on. The Vite dev server proxies to it.
PORT=4000

# Where the SQLite file lives, relative to the server/ folder.
DATABASE_FILE=data/vong.db

# Leave unset in development. In production set it to your site's origin,
# e.g. https://vong.vn, so only your own frontend can call the API.
# CORS_ORIGIN=https://your-domain.com
